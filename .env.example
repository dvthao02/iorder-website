# CMS API
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
ADMIN_ORIGIN=http://127.0.0.1:5174
PUBLIC_ORIGIN=http://127.0.0.1:5173

# Create the database before running migrations.
DATABASE_URL=postgresql://admin_iorder:replace-with-local-password@127.0.0.1:5432/iorderCMS

# Authentication values are placeholders until the auth module is implemented.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=7

# Public media storage. Relative paths are resolved from apps/api.
MEDIA_STORAGE_PATH=../../storage/media
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:4000/media
MEDIA_MAX_FILE_SIZE_MB=20
HOMEPAGE_SLUG=home

# Tin cậy reverse proxy (nginx) để lấy IP thật từ X-Forwarded-For (đếm lượt xem chính xác).
# Đặt 'true' khi chạy sau nginx; số hop; hoặc danh sách IP/subnet. Mặc định 'false'.
TRUST_PROXY=false

# (Tùy chọn) Kết nối DB iOrder App để đếm số cửa hàng thực tế trong stats bar.
# Nhiều DB cách nhau dấu phẩy để cộng tổng.
# IORDER_APP_DB_URLS=postgresql://user:pass@host:5432/iorder_app

# Used only by `pnpm.cmd cms:create-admin`.
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_NAME=CMS Administrator
CMS_ADMIN_PASSWORD=replace-with-local-password
