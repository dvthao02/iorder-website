# Railway production variables for the iorder-website app service.
# Paste these into Railway app service Variables, not the Postgres service.
# If your database service is not named "Postgres", replace Postgres below
# with the exact Railway service name shown in the project canvas.

DATABASE_URL=${{Postgres.DATABASE_URL}}
NODE_ENV=production
API_HOST=0.0.0.0
# Do not set API_PORT=4000 on Railway. Leave API_PORT unset so the app uses Railway's PORT.

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=7
CMS_PREVIEW_SECRET=replace-with-another-32-random-characters

PUBLIC_ORIGIN=https://iorder-website-production.up.railway.app
ADMIN_ORIGIN=https://iorder-website-production.up.railway.app

MEDIA_STORAGE_PATH=/app/storage/media
MEDIA_PUBLIC_BASE_URL=https://iorder-website-production.up.railway.app/media
MEDIA_MAX_FILE_SIZE_MB=20
HOMEPAGE_SLUG=home

TRUST_PROXY=true
POST_SCHEDULER_ENABLED=true
POST_SCHEDULER_INTERVAL_MS=60000

# Used only for the first CMS admin bootstrap command.
# Remove CMS_ADMIN_PASSWORD after the first successful create-admin run.
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_NAME=CMS Administrator
CMS_ADMIN_PASSWORD=replace-with-a-strong-temporary-password

# Optional Sentry variables.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# The repository's railway.json already runs this before API start:
# pnpm railway:bootstrap
# which applies migrations, seeds core data, and creates/updates the admin user.

# Optional one-time content import command, run manually only after the API/database are healthy:
# pnpm --filter @iorder/api import:homepage && pnpm --filter @iorder/api import:posts && pnpm --filter @iorder/api import:offerings
