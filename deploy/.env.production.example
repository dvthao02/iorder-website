# Copy this file to .env.production and replace every placeholder before use.
APP_PORT=4000
VOLUME_PREFIX=iorder_production

# Database
POSTGRES_PASSWORD=your-strong-password-here

# Session (tối thiểu 32 ký tự, random string)
SESSION_SECRET=your-very-long-random-session-secret-here
CMS_PREVIEW_SECRET=your-very-long-random-preview-secret-here

# Domain của bạn (có https://)
SITE_URL=https://iorder.com.vn

# Admin CMS
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=your-admin-password
CMS_ADMIN_NAME=Administrator

# Object storage: use MinIO only when it has a durable volume, backup, and a public media domain.
MEDIA_STORAGE_DRIVER=minio
MEDIA_STORAGE_PATH=/app/storage/media
MEDIA_PUBLIC_BASE_URL=https://media.iorder.com.vn/iorder-media
MEDIA_S3_ENDPOINT=minio.internal
MEDIA_S3_PORT=9000
MEDIA_S3_USE_SSL=true
MEDIA_S3_ACCESS_KEY=replace-with-minio-service-access-key
MEDIA_S3_SECRET_KEY=replace-with-minio-service-secret-key
MINIO_BUCKET=iorder-media

# Needed only when this Compose stack hosts MinIO itself. Do not use root credentials in the API.
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-minio-root-password

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
