# Copy file này thành .env.production và điền giá trị thật

# Database
POSTGRES_PASSWORD=your-strong-password-here

# Session (tối thiểu 32 ký tự, random string)
SESSION_SECRET=your-very-long-random-session-secret-here

# Domain của bạn (có https://)
SITE_URL=https://iorder.com.vn

# Admin CMS
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=your-admin-password
CMS_ADMIN_NAME=Administrator
