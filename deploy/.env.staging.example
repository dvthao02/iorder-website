# Copy thành deploy/.env trên VPS staging riêng, không dùng chung volume/port/secret với production.
APP_PORT=127.0.0.1:4100
SITE_URL=https://staging.iorder.example
VOLUME_PREFIX=iorder_staging

# CI/CD sẽ gán tag image cùng một commit đã qua CI.
API_IMAGE=ghcr.io/dvthao02/iorder-api:sha-replace-me
WEB_IMAGE=ghcr.io/dvthao02/iorder-web:sha-replace-me
MINIO_IMAGE=ghcr.io/dvthao02/iorder-minio:sha-replace-me

POSTGRES_PASSWORD=replace-with-staging-password
SESSION_SECRET=replace-with-at-least-32-random-characters
CMS_PREVIEW_SECRET=replace-with-at-least-32-random-characters
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=replace-with-staging-admin-password
CMS_ADMIN_NAME=Staging Administrator

MEDIA_STORAGE_DRIVER=minio
MEDIA_PUBLIC_BASE_URL=https://media-staging.iorder.example/iorder-media
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ROOT_USER=replace-with-staging-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-staging-minio-root-password
MINIO_BUCKET=iorder-media
MEDIA_S3_ACCESS_KEY=replace-with-staging-minio-service-user
MEDIA_S3_SECRET_KEY=replace-with-staging-minio-service-password

SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=staging
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
