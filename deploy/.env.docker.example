APP_PORT=4000
SITE_URL=http://127.0.0.1:4000
VOLUME_PREFIX=iorder_local
# Để trống khi build từ source checkout. CI/CD production sẽ gán image theo commit SHA.
API_IMAGE=
WEB_IMAGE=
MINIO_IMAGE=
POSTGRES_PASSWORD=iorder-local-postgres-password
SESSION_SECRET=iorder-local-session-secret-at-least-32-characters
CMS_PREVIEW_SECRET=iorder-local-preview-secret-at-least-32-characters
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=iorder-local-admin-password
CMS_ADMIN_NAME=Administrator

# Media storage (MinIO API: 9000, management console: 9001)
MEDIA_STORAGE_DRIVER=minio
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:9000/iorder-media
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=iorder-local-minio-root
MINIO_ROOT_PASSWORD=iorder-local-minio-root-password
MINIO_BUCKET=iorder-media
MEDIA_S3_ACCESS_KEY=iorder-local-minio-root
MEDIA_S3_SECRET_KEY=iorder-local-minio-root-password

SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=local
SENTRY_TRACES_SAMPLE_RATE=0
