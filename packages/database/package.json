{
  "name": "@iorder/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:create": "psql -v ON_ERROR_STOP=1 -v db_name=iorderCMS -d postgres -f scripts/00-create-database.sql",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:normalize-ownership": "psql -v ON_ERROR_STOP=1 -v app_owner=admin_iorder -d iorderCMS -f scripts/02-normalize-ownership.sql",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
