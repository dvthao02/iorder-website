{
  "name": "@iorder/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "gen:sitemap": "tsx src/scripts/generate-sitemap.ts",
    "import:homepage": "tsx src/scripts/import-current-homepage.ts",
    "import:posts": "tsx src/scripts/import-current-posts.ts",
    "import:offerings": "tsx src/scripts/import-current-offerings.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "tsx src/smoke.ts",
    "test:auth": "tsx src/auth-smoke.ts",
    "test:media": "tsx src/media-smoke.ts",
    "test:posts": "tsx src/posts-smoke.ts",
    "test:offerings": "tsx src/offerings-smoke.ts",
    "test:unit": "vitest run",
    "test:homepage": "tsx src/homepage-smoke.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/multipart": "10.0.0",
    "@fastify/rate-limit": "11.0.0",
    "@fastify/static": "9.1.3",
    "@iorder/contracts": "workspace:*",
    "@iorder/database": "workspace:*",
    "@sentry/node": "^10.62.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "image-size": "2.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  }
}
